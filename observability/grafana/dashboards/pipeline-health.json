      "type": "timeseries",
      "title": "Micro-batch duration per query",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 14
