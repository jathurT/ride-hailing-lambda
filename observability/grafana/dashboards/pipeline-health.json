{
  "uid": "fleet-pipeline-health",
  "title": "Fleet \u00b7 Pipeline Health",
  "description": "End-to-end health of the Lambda pipeline, one column per stage: INGEST, PROCESS, STORE, SERVE. Provisioned from observability/grafana/dashboards/ \u2014 edits made here are lost on container restart; change the file.",
  "tags": [
    "fleet",
    "lambda",
    "pipeline"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance \u2014 one number per stage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INGEST \u00b7 events/sec",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(events_produced_total{status=\"ok\"}[1m]))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "reqps",
          "decimals": 1,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Telemetry accepted by Kafka. Zero here means the producers are down and nothing below this panel means anything."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PROCESS \u00b7 seconds since last Spark progress",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - spark_streaming_last_progress_timestamp)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s",
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "\u2605 THE liveness signal for the speed layer. Consumer lag cannot measure these queries \u2014 they checkpoint their own offsets and never commit to a group, so lag reads zero whether they are keeping up or dead. A query that stops emits no progress, so the AGE of this timestamp is the only thing that separates 'idle' from 'died an hour ago'."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "STORE \u00b7 sink write errors/sec",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sink_write_errors_total[5m]))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Writes to Redis, Parquet or Kafka that failed. Anything sustained above zero means the speed view is drifting out of date silently."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SERVE \u00b7 batch watermark age (sim days)",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(serving_batch_watermark_age_sim_days)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Simulated days between the batch high-water mark and now. 1 is healthy (yesterday is complete). Climbing means the batch layer has stopped, which looks identical to a healthy pipeline from every other angle."
    },
    {
      "id": 6,
      "type": "row",
      "title": "INGEST \u2014 the simulated sources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Events produced /sec by topic",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(events_produced_total{status=\"ok\"}[1m]))",
          "legendFormat": "{{topic}} ok",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (topic) (rate(events_produced_total{status!=\"ok\"}[1m]))",
          "legendFormat": "{{topic}} FAILED",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Delivery-callback outcomes, not produce() calls. A gap between ok and failed is the broker rejecting writes."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Producer errors and backpressure /sec",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (rate(producer_errors_total[1m]))",
          "legendFormat": "error: {{error_type}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        },
        {
          "refId": "B",
          "expr": "rate(producer_backpressure_events_total[1m])",
          "legendFormat": "backpressure",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        },
        {
          "refId": "C",
          "expr": "rate(vehicle_resyncs_total[1m])",
          "legendFormat": "vehicle resyncs",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Backpressure is deliberate \u2014 the producer blocks rather than dropping telemetry. Resyncs rising means the host cannot sustain the event rate: a capacity signal, not a correctness one. This condition used to crash the producer, and Docker's restart policy hid it behind healthy throughput."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Defects injected /sec by type",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (defect_type) (rate(defects_injected_total[1m]))",
          "legendFormat": "{{defect_type}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The simulator corrupts a known fraction of events on purpose. This line is the control for the DLQ: what goes in here must come out of the dead-letter path, and a mismatch is a validator that is not catching what it claims to."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Simulated clock \u2014 day index and drift",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sim_clock_day_index)",
          "legendFormat": "sim day index",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        },
        {
          "refId": "B",
          "expr": "max(sim_clock_drift_seconds)",
          "legendFormat": "drift (s)",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Every container derives simulated time from one shared anchor file. Drift between them means two services disagree about what day it is, and every windowed aggregate downstream becomes untrustworthy."
    },
    {
      "id": 11,
      "type": "row",
      "title": "PROCESS \u2014 Spark Structured Streaming (pushed, not scraped)",
      "collapsed": false,
