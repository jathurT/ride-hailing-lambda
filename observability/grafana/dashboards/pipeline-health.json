    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Sink write errors /sec",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sink) (rate(sink_write_errors_total[5m]))",
          "legendFormat": "{{sink}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
