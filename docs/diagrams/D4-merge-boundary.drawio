<mxfile host="build_drawio.py"><diagram id="D4-merge-boundary" name="D4-merge-boundary"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;(a) Healthy&lt;/b&gt;&lt;br&gt;high-water mark: d minus 1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;(b) Batch three days behind&lt;/b&gt;&lt;br&gt;high-water mark: d minus 3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="0" width="300" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;d minus 4&lt;/b&gt;: batch" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="55" width="300" height="45" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;d minus 4&lt;/b&gt;: batch" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="55" width="300" height="45" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;d minus 3&lt;/b&gt;: batch" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="115" width="300" height="45" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;d minus 3&lt;/b&gt;: batch" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="115" width="300" height="45" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;d minus 2&lt;/b&gt;: batch" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="175" width="300" height="45" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;d minus 2&lt;/b&gt;: not covered" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="175" width="300" height="45" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;d minus 1&lt;/b&gt;: batch" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="235" width="300" height="45" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;d minus 1&lt;/b&gt;: not covered" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="235" width="300" height="45" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;d (today)&lt;/b&gt;: speed" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="295" width="300" height="45" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;d (today)&lt;/b&gt;: speed" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="295" width="300" height="45" as="geometry"/></mxCell><mxCell id="c13" value="Every date has exactly one owner, so nothing is counted twice.&lt;br&gt;If the batch falls behind, the gap is reported, not hidden." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="365" width="700" height="50" as="geometry"/></mxCell></root></mxGraphModel></dia