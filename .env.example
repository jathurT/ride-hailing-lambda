# ---------------------------------------------------------------------------
# Ride-Hailing Fleet Operations - configuration
# Copy to .env (git-ignored). Every value the code reads appears here.
# ---------------------------------------------------------------------------

COMPOSE_PROFILES=run

# --- simulated clock -------------------------------------------------------
# 1 simulated day = 300 real seconds => 288x speed-up. Matches the compression
# suggested in the assignment brief. See plan/03 section 3.
SIM_DAY_SECONDS=300
SIM_EPOCH_SIM=2026-03-01T00:00:00Z
SIM_STATE_PATH=/state/sim_epoch.json

# --- the simulated fleet ---------------------------------------------------
FLEET_SIZE=150
FLEET_TARGET_EPS=240
FLEET_PING_INTERVAL_SIM_MINUTES=3
FLEET_DEFECT_RATE=0.01
FLEET_RANDOM_SEED=42

# --- kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_TELEMETRY_TOPIC=fleet.telemetry.v1
KAFKA_REGISTRY_TOPIC=fleet.vehicle.registry
KAFKA_ALERTS_TOPIC=fleet.alerts.v1
KAFKA_DLQ_TOPIC=fleet.telemetry.dlq
KAFKA_TELEMETRY_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
# Design value is 7 days; the demo uses 1 real hour because 7 days of real-time
# production would be ~36 GB. Declared in the report - plan/04 section 1.4.
KAFKA_TELEMETRY_RETENTION_MS=3600000
KAFKA_TELEMETRY_RETENTION_BYTES=2147483648

# --- processing (all values in SIMULATED time) -----------------------------
# 30 sim-minutes / 288x = 6.25 real seconds of lateness tolerance.
# config.py refuses to start if this drops below 5 real seconds.
PROC_WATERMARK_SIM_MINUTES=30
PROC_WINDOW_SIM_MINUTES=15
PROC_WINDOW_SLIDE_SIM_MINUTES=5
PROC_IDLE_ALERT_SIM_MINUTES=45
PROC_IDLE_CRITICAL_SIM_MINUTES=90
PROC_TRIGGER_SECONDS=10

# --- storage ---------------------------------------------------------------
STORE_MINIO_ENDPOINT=http://minio:9000
STORE_MINIO_ACCESS_KEY=fleetadmin
STORE_MINIO_SECRET_KEY=fleetadmin
STORE_LAKE_BUCKET=fleet-lake
STORE_POSTGRES_DSN=postgresql://fleet:fleet@postgres-mart:5432/fleet_mart
STORE_REDIS_URL=redis://redis:6379/0
STORE_SPEED_VIEW_TTL_SIM_HOURS=2
STORE_VEHICLE_STATE_TTL_SIM_MINUTES=30

# --- observability ---------------------------------------------------------
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
OBS_SERVICE_NAME=fleet
OBS_METRICS_PORT=8001
OBS_PUSHGATEWAY_URL=http://pushgateway:9091
OBS_OTEL_ENDPOINT=http://otel-collector:4317
OBS_OTEL_ENABLED=false
